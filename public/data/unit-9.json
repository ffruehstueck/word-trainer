  { "id": 27, "source": "Can I have a slice of your pizza?", "target": "Kann ich ein Stück von deiner Pizza haben?", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 28, "source": "I want to be an actor, but I need the money.", "target": "Ich möchte Schauspieler werden, aber ich brauche das Geld.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 29, "source": "Here comes the main course.", "target": "Hier kommt der Hauptgang.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 30, "source": "Let me pour it for you.", "target": "Lass mich es für dich einschenken.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 31, "source": "One tomato soup for you and the onion soup for your husband.", "target": "Eine Tomatensuppe für Sie und die Zwiebelsuppe für Ihren Mann.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 32, "source": "The restaurant serves a delicious soup as a starter.", "target": "Das Restaurant serviert eine köstliche Suppe als Vorspeise.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 33, "source": "I'll bring the soup straightaway.", "target": "Ich bringe die Suppe sofort.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 34, "source": "The restaurant is completely dark.", "target": "Das Restaurant ist komplett dunkel.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 35, "source": "A crane holds a large platform more than 50 m above the ground.", "target": "Ein Kran hält eine große Plattform mehr als 50 m über dem Boden.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 36, "source": "You shouldn't drop your phone on the ground.", "target": "Du solltest dein Handy nicht auf den Boden fallen lassen.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 37, "source": "The robots dance to entertain the guests.", "target": "Die Roboter tanzen, um die Gäste zu unterhalten.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 38, "source": "The waiter wears special glasses so that he can see in the dark.", "target": "Der Kellner trägt eine spezielle Brille, damit er im Dunkeln sehen kann.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 39, "source": "There's a restaurant on a platform in the sky.", "target": "Es gibt ein Restaurant auf einer Plattform im Himmel.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 40, "source": "The waiters serve the food.", "target": "Die Kellner servieren das Essen.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 41, "source": "There are several restaurants in my town.", "target": "Es gibt mehrere Restaurants in meiner Stadt.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 42, "source": "Can I have the cabbage stew, please?", "target": "Kann ich bitte den Kohleintopf haben?", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 43, "source": "There's nothing in the fridge. Let's go to the supermarket.", "target": "Im Kühlschrank ist nichts. Gehen wir zum Supermarkt.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 44, "source": "They complain about their food.", "target": "Sie beschweren sich über ihr Essen.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 45, "source": "A consumer is someone who buys something.", "target": "Ein Konsument ist jemand, der etwas kauft.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 46, "source": "I'm waiting for my pizza delivery.", "target": "Ich warte auf meine Pizza-Lieferung.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 47, "source": "I downloaded the new Dua Lipa album.", "target": "Ich habe das neue Dua-Lipa-Album heruntergeladen.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 48, "source": "My phone stopped working. I want a refund.", "target": "Mein Handy funktioniert nicht mehr. Ich möchte eine Rückerstattung.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 49, "source": "Are you certain?", "target": "Bist du sicher?", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 50, "source": "I changed my mind. I want pizza after all.", "target": "Ich habe meine Meinung geändert. Ich will doch Pizza.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 51, "source": "Leo goes to the gym.", "target": "Leo geht ins Fitnessstudio.", "sourceLanguage": "English", "targetLanguage": "German" },
