  { "id": 32, "source": "Have you ever won a competition?", "target": "Hast du schon einmal einen Wettbewerb gewonnen?", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 33, "source": "The competition was a big challenge for me.", "target": "Der Wettbewerb war eine große Herausforderung für mich.", "sourceLanguage": "English", "targetLanguage": "German" },
