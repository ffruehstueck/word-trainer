  { "id": 35, "source": "I've never tried any extreme sports.", "target": "Ich habe noch nie Extremsportarten ausprobiert.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 36, "source": "The bridge broke after a big flood.", "target": "Die Brücke brach nach einer großen Flut.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 37, "source": "A team from New Zealand managed to set a new record.", "target": "Ein Team aus Neuseeland schaffte es, einen neuen Rekord aufzustellen.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 38, "source": "Has there ever been an official record?", "target": "Gab es jemals einen offiziellen Rekord?", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 39, "source": "Egg throwing is a rather unusual sport.", "target": "Eierwerfen ist ein ziemlich ungewöhnlicher Sport.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 40, "source": "I love to snorkel in the sea.", "target": "Ich liebe es, im Meer zu schnorcheln.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 41, "source": "Do you want to take part in a competition?", "target": "Möchtest du an einem Wettbewerb teilnehmen?", "sourceLanguage": "English", "targetLanguage": "German" },
