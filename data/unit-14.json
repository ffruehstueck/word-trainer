  { "id": 26, "source": "When I grow up, I want to be an Olympic skier.", "target": "Wenn ich erwachsen bin, möchte ich olympischer Skifahrer werden.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 27, "source": "She's a member of the school team.", "target": "Sie ist Mitglied des Schulteams.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 28, "source": "I want to play professional basketball.", "target": "Ich möchte professionell Basketball spielen.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 29, "source": "I won my first race last week.", "target": "Ich habe letzte Woche mein erstes Rennen gewonnen.", "sourceLanguage": "English", "targetLanguage": "German" },
  { "id": 30, "source": "Have you ever had any serious accidents?", "target": "Hattest du schon einmal einen schweren Unfall?", "sourceLanguage": "English", "targetLanguage": "German" },
